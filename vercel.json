{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": { "includeFiles": "db.json" }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/payments", "destination": "/index.html" },
    { "source": "/blog/:id", "destination": "/blog/index.html" }
  ]
}
